# Server configuration. Copy this file to .env and fill in values locally.
# Never commit backend/.env or paste real credentials into GitHub issues or chat.
MONGO_URL=mongodb://localhost:27017
DB_NAME=studio_m
CORS_ORIGINS=https://your-domain.example
APP_URL=https://your-domain.example
APP_TZ=Europe/Prague

# Reservation assistant API (the trained external agent)
EXTERNAL_AGENT_URL=https://agent-provider.example/api/chat
EXTERNAL_AGENT_TOKEN=replace_with_agent_token

# Nail Stylist pipeline, if it is provided by the current built-in pipeline
ANTHROPIC_API_KEY=replace_with_anthropic_key
GEMINI_API_KEY=replace_with_google_ai_key

# Google Calendar OAuth client (do not put the calendar password here)
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret
GOOGLE_REDIRECT_URI=https://your-domain.example/api/oauth/calendar/callback
# The shared business calendar where reservations are created.
GOOGLE_CALENDAR_ID=your-shared-calendar-id@group.calendar.google.com
